{
  "version": 1,
  "targetVersion": "2.44.6",
  "note": "黃金情境（合成資料）。假金鑰用 {{FAKE_*}} 占位，執行時才由程式組合。",
  "scenarios": [
    {
      "id": "G01",
      "title": "訂單狀態查詢 API",
      "category": "webhook-api",
      "prompt": "我們內部的訂單系統想問 n8n 一個問題：丟一個訂單編號過來，就回傳這張單現在的狀態。狀態先用寫死的對照就好（像是 A001 處理中、A002 已出貨，查不到就回「查無此單」），之後再換成真的資料庫。",
      "credentialMap": {
        "httpHeaderAuth": [
          "internal-api-header"
        ]
      },
      "targetVersion": "2.44.6",
      "expect": {
        "mode": "generate",
        "maxBlocking": 0,
        "requireLayer3Note": true,
        "requireNodeNotesForCode": true,
        "credentialsMustBeSubsetOf": "credentialMap",
        "triggerAnyOf": [
          "n8n-nodes-base.webhook"
        ],
        "mustIncludeAll": [
          "n8n-nodes-base.respondToWebhook"
        ],
        "mustIncludeAnyOf": [
          "n8n-nodes-base.switch",
          "n8n-nodes-base.if",
          "n8n-nodes-base.set"
        ],
        "maxCodeNodeRatio": 0.34,
        "notes": "入口是 webhook 並有明確的回應節點；對照邏輯優先用原生節點，Code 占比不超過三分之一。"
      }
    },
    {
      "id": "G02",
      "title": "文字字數 API 與空值錯誤",
      "category": "webhook-api",
      "prompt": "想做一個小 API：外面 POST 一段文字進來，我要回傳這段文字有幾個字，還有前 20 個字。如果送進來的是空的，要回一個錯誤訊息跟 400，不要回 200。",
      "credentialMap": {},
      "targetVersion": "2.44.6",
      "expect": {
        "mode": "generate",
        "maxBlocking": 0,
        "requireLayer3Note": true,
        "requireNodeNotesForCode": true,
        "credentialsMustBeSubsetOf": "credentialMap",
        "triggerAnyOf": [
          "n8n-nodes-base.webhook"
        ],
        "mustIncludeAll": [
          "n8n-nodes-base.respondToWebhook"
        ],
        "mustIncludeAnyOf": [
          "n8n-nodes-base.if",
          "n8n-nodes-base.switch",
          "n8n-nodes-base.filter"
        ],
        "maxCodeNodeRatio": 0.34,
        "notes": "需要分支處理空值，成功與失敗兩條路都要走到回應節點。"
      }
    },
    {
      "id": "G03",
      "title": "標頭 token 認證的歡迎 API",
      "category": "webhook-api",
      "prompt": "呼叫端會在標頭帶一個 token，對的才給資料，不對就回 401。給的資料就是今天日期加一句歡迎詞。token 的憑證管理員應該已經建好了。",
      "credentialMap": {
        "httpHeaderAuth": [
          "partner-token-header"
        ]
      },
      "targetVersion": "2.44.6",
      "expect": {
        "mode": "generate",
        "maxBlocking": 0,
        "requireLayer3Note": true,
        "requireNodeNotesForCode": true,
        "credentialsMustBeSubsetOf": "credentialMap",
        "triggerAnyOf": [
          "n8n-nodes-base.webhook"
        ],
        "mustIncludeAll": [
          "n8n-nodes-base.respondToWebhook"
        ],
        "forbidAdvisoryRules": [
          "webhook:no-auth"
