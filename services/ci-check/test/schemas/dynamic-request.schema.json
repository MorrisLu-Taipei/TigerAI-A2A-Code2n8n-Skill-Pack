{
 "$id": "https://spec.example.internal/n8n-check/v1/dynamic-request.schema.json",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "requestId",
  "workflows"
 ],
 "anyOf": [
  {
   "required": [
    "targetVersion"
   ]
  },
  {
   "required": [
    "matrixVersions"
   ]
  }
 ],
 "properties": {
  "requestId": {
   "$ref": "#/$defs/requestId"
  },
  "targetVersion": {
   "$ref": "#/$defs/version"
  },
  "matrixVersions": {
   "type": "array",
   "minItems": 1,
   "maxItems": 3,
   "uniqueItems": true,
   "items": {
    "$ref": "#/$defs/version"
   }
  },
  "workflows": {
   "type": "array",
   "minItems": 1,
   "maxItems": 20,
   "items": {
    "$ref": "#/$defs/workflowFile"
   }
  },
  "credentialStubPolicy": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "mode": {
     "type": "string",
     "enum": [
      "stub-all",
      "strip"
     ],
     "default": "stub-all"
    }
   }
  },
  "options": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "matrixPolicy": {
     "type": "string",
     "enum": [
      "target-only",
      "all"
     ]
    },
    "settleSeconds": {
     "type": "integer",
     "minimum": 0,
     "maximum": 10,
     "default": 3
    },
    "perWorkflowTimeoutSeconds": {
     "type": "integer",
     "minimum": 10,
     "maximum": 120,
     "default": 60
    },
    "jobTimeoutSeconds": {
     "type": "integer",
     "minimum": 60,
     "maximum": 1800,
     "default": 900
    }
   }
  }
 },
 "$defs": {
  "requestId": {
   "type": "string",
   "pattern": "^[A-Za-z0-9._:-]{8,64}$"
  },
  "version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "filePath": {
   "type": "string",
   "pattern": "^(?!/)(?!.*(?:^|/)\\.)(?!.*(?:^|/)node_modules(?:/|$))(?!.*//)[^\\\\\\x00-\\x1f\\x7f]{1,200}\\.json$"
  },
  "workflowFile": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "content"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/filePath"
    },
    "content": {
     "type": "string",
     "minLength": 2,
     "maxLength": 1048576
    }
   }
  }
 }
}