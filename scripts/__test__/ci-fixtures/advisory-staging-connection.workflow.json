{
  "name": "ci-fixture advisory staging connection",
  "settings": {},
  "connections": {
    "Manual trigger": {
      "main": [
        [
          {
            "node": "Read config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read config": {
      "main": [
        [
          {
            "node": "Call local",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "nodes": [
    {
      "id": "manual-trigger",
      "name": "Manual trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "read-config",
      "name": "Read config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "apiBase",
              "value": "={{ $vars.apiBase }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "label",
              "value": "=ci fixture",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "call-local",
      "name": "Call local",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "url": "http://localhost:5678/healthz",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Demo",
              "value": "={{ $secrets.vault.demoKey }}"
            }
          ]
        },
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "plain-note",
      "name": "Plain note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        260,
        300
      ],
      "parameters": {
        "color": 4,
        "content": "備忘：之後會用 $vars 與 $secrets，這裡只是說明文字，不會被執行。"
      }
    }
  ]
}
